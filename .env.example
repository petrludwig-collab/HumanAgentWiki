# Copy to .env and adjust. (python-dotenv not required — these are plain env vars.)

# Folder with your Markdown notes
NOTES_DIR=./notes

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=dbname=humanagentwiki user=humanagentwiki password=humanagentwiki host=localhost port=5432

# Embedding model — BGE-M3 is multilingual (great for Czech and 100+ languages).
# If you change the model, set EMBED_DIM to its dimension and re-create the schema.
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# Operational cap for embedding inputs. Keep this lower than the model limit
# on memory-constrained devices such as Apple Silicon GPUs.
EMBED_MAX_TOKENS=1024
# Token-aware chunking (bge-m3 tokenizer tokens, not characters). Keep EMBED_CHUNK_TOKENS
# below EMBED_MAX_TOKENS so no chunk is ever truncated by the model. Overlap is added
# to the embedded text only. Sections with these headings are treated as reference lists
# (kept + keyword-searchable, but excluded from vector ranking).
# EMBED_CHUNK_TOKENS=480
# EMBED_OVERLAP_TOKENS=48
# REFERENCE_SECTIONS=zdroje,sources,references,reference,literatura,odkazy,bibliography

# MCP server bind (the AI agents connect here over http://HOST:PORT/mcp)
MCP_HOST=127.0.0.1
MCP_PORT=8802

# Web UI bind. Keep 127.0.0.1 unless you expose it over LAN/VPN (then set 0.0.0.0
# AND set WEB_AUTH below — the UI shows all your notes).
WEB_HOST=127.0.0.1
WEB_PORT=8808

# Optional HTTP Basic auth for the web UI. Empty/unset = open. Format: user:password
# WEB_AUTH=admin:change-me
